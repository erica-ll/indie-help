.env
__pycache__/
*.pyc
.DS_Store

# tests/ is mostly local-only (generated answers, local eval/scoring
# scripts, precomputed decompositions, experiment-log snapshots like
# 0.0/, 1.0/, 2.3/, etc.). Only the live tryout architectures and the
# canonical test-question source files are meant to be tracked/pushed.
tests/*
!tests/tryouts/
!tests/rubric.txt
!tests/test_prompts.txt
!tests/test_gt.txt
